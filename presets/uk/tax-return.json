{
  "id": "uk.tax-return",
  "version": 2,
  "name": "UK Tax Return (SA100, SA302, P60, P45)",
  "emoji": "🇬🇧",
  "description": "UK Self Assessment documents: the SA100 tax return, the SA302 tax calculation and the P60 and P45 from an employer. Hides what points to you: your name and address, postcode, phone, e-mail, National Insurance number, UTR and date of birth, also when they are written one character per box, plus the bank sort code, account number and IBAN for refunds, the employer PAYE and Accounts Office references and your payroll number. Keeps what an accountant or an AI needs to read the return: every amount, box number, tax year, tax code, form name (SA100, SA102, SA302...), HMRC's own address and helpline numbers, and the employer's name (switch on Employer to hide it). Limits: on scans and photos, characters in boxes are often read one by one and can be missed, so check those fields; a date of birth after 2009 is found only right after its label; signatures need a manual box.",
  "language": "en",
  "country": "GB",
  "tags": [
    "uk",
    "united kingdom",
    "hmrc",
    "tax return",
    "self assessment",
    "sa100",
    "sa302",
    "p60",
    "p45",
    "national insurance",
    "nino",
    "utr",
    "tax",
    "gdpr"
  ],
  "patterns": [
    {
      "name": "NI number",
      "regex": "(?-i)(?<![A-Za-z0-9])[A-Z][ \\t]?[A-Z][ \\t\\-]{0,3}\\d[ \\t]?\\d[ \\t\\-]{0,3}\\d[ \\t]?\\d[ \\t\\-]{0,3}\\d[ \\t]?\\d[ \\t\\-]{0,3}[A-D](?![A-Za-z0-9])|(?-i:(?<![A-Za-z0-9])(?<![A-Za-z0-9] )[A-Z] [A-Z](?: \\d){2,6} [A-D](?![A-Za-z0-9]))|(?<![^\\n])(?!SA|CT|TR|BX|NE|GB)[A-Z]{2}[ \\t|]{0,2}\\d{2}(?:[ \\t|]{0,2}\\d{1,2}){1,2}(?=[ \\t]{0,3}(?![^\\n]))",
      "description": "National Insurance number in any spacing: QQ 12 34 56 C, QQ123456C, or one character per box; on a scan, also a line that holds only its first part (QQ12345) when the rest is read apart.",
      "enabled": true
    },
    {
      "name": "UTR",
      "regex": "(?<!\\d)(?<!\\d[ \\t])(?:\\d{5}[ \\t]?\\d{5}|\\d(?:[ \\t]\\d){9})(?:[ \\t]?K)?(?![ \\t]?\\d)",
      "description": "Unique Taxpayer Reference: 10 digits, written 12345 67890, 1234567890 or one digit per box.",
      "enabled": true
    },
    {
      "name": "Date of birth",
      "regex": "(?:(?=\\d{1,2}(?:[ \\t/.\\-]|st|nd|rd|th)|\\d[ \\t]\\d|\\d{8}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))(?<!\\d)(?<!\\d[ \\t])(?<=(?:date[ \\t]?of[ \\t]?birth|birth[ \\t]?date|D\\.?O\\.?B\\.?|born(?:[ \\t]on)?)[^\\n\\d]{0,30})(?:(?:(?:0?[1-9]|[12]\\d|3[01])[ \\t]{0,2}[/.\\-][ \\t]{0,2}(?:0?[1-9]|1[0-2])[ \\t]{0,2}[/.\\-][ \\t]{0,2}(?:19|20)\\d{2}|(?:0[ \\t]?[1-9]|[12][ \\t]?\\d|3[ \\t]?[01])[ \\t]{0,3}(?:0[ \\t]?[1-9]|1[ \\t]?[0-2])[ \\t]{0,3}(?:1[ \\t]?9[ \\t]?\\d[ \\t]?\\d|2[ \\t]?0[ \\t]?\\d[ \\t]?\\d))|(?:(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?[ \\t]{1,2}(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?,?[ \\t]{1,2}(?:19|20)\\d{2}|(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?[ \\t]{1,2}(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?,?[ \\t]{1,2}(?:19|20)\\d{2}))(?![ \\t]?\\d))|(?:(?=\\d[\\d \\t/.\\-]{1,12}(?:1[ \\t]?9|2[ \\t]?0[ \\t]?0)|\\d{1,2}(?:st|nd|rd|th)?[ \\t]{1,2}[A-Za-z]|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec))(?<!\\d)(?<!\\d[ \\t])(?:(?:(?:0?[1-9]|[12]\\d|3[01])[ \\t]{0,2}[/.\\-][ \\t]{0,2}(?:0?[1-9]|1[0-2])[ \\t]{0,2}[/.\\-][ \\t]{0,2}(?:19\\d{2}|200\\d)|(?:0[ \\t]?[1-9]|[12][ \\t]?\\d|3[ \\t]?[01])[ \\t]{0,3}(?:0[ \\t]?[1-9]|1[ \\t]?[0-2])[ \\t]{0,3}(?:1[ \\t]?9[ \\t]?\\d[ \\t]?\\d|2[ \\t]?0[ \\t]?0[ \\t]?\\d))|(?:(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?[ \\t]{1,2}(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?,?[ \\t]{1,2}(?:19\\d{2}|200\\d)|(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?[ \\t]{1,2}(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?,?[ \\t]{1,2}(?:19\\d{2}|200\\d)))(?![ \\t]?\\d))",
      "description": "A date after Date of birth, DOB or Born in any common format, also in boxes, and any full date with a year from 1900 to 2009 (14/03/1987, 14 03 1987, 14 March 1987), the way a birth date appears on a tax form. Dates of the tax years stay visible.",
      "enabled": true
    },
    {
      "name": "Person",
      "regex": "(?-i)(?:(?=[A-Z])(?<=[A-Za-z.][ \\t])(?<=(?<![A-Za-z])(?:MR|MRS|MS|MISS|MX|DR|Mr|Mrs|Ms|Miss|Mx|Dr)\\.?[ \\t]{1,3})(?!(?:First|Surname|Forenames?|Name|Date|Address|Title|National|Employee|Employer|Tax|Postcode|Works|Payroll|Signature|Account|Accounts|Bank|Branch|Sort|UTR|NI|NINO|Your|Leaving|Total|Pay|Final|Certificate|Unique|Issue|Income|Telephone|Phone|Email|Reference|Ref|HM|HMRC|Revenue|Customs|Page|Box|Example)(?![A-Za-z]))(?:[A-Z](?:[a-z'’\\-]+|[A-Z'’\\-]+)(?![A-Za-z0-9])|[A-Z]\\.?(?![A-Za-z0-9]))(?:[ \\t]{1,2}(?!(?:First|Surname|Forenames?|Name|Date|Address|Title|National|Employee|Employer|Tax|Postcode|Works|Payroll|Signature|Account|Accounts|Bank|Branch|Sort|UTR|NI|NINO|Your|Leaving|Total|Pay|Final|Certificate|Unique|Issue|Income|Telephone|Phone|Email|Reference|Ref|HM|HMRC|Revenue|Customs|Page|Box|Example)(?![A-Za-z]))(?:[A-Z](?:[a-z'’\\-]+|[A-Z'’\\-]+)(?![A-Za-z0-9])|[A-Z]\\.?(?![A-Za-z0-9]))){1,4})|(?:(?<![A-Za-z0-9])(?<![A-Za-z0-9][ \\t])[A-Z](?:[ \\t][A-Z'’\\-]){2,24}(?![ \\t]?[A-Za-z0-9]))|(?i:(?=(?-i:[A-Z]))(?<=(?:me|es|er|ls|s\\)|:)[ \\t\\n]{1,6})(?<=(?:(?<![A-Za-z])name|full[ \\t]?name|account[ \\t]?holder|surname(?:[ \\t]?or[ \\t]?family[ \\t]?name)?|forenames?(?:[ \\t]?or[ \\t]?initials)?|first[ \\t]?names?(?:[ \\t]?\\(s\\))?|first[ \\t]?name\\(s\\)|(?:employee|taxpayer|partner|spouse)(?:'s|’s)?[ \\t]?(?:full[ \\t]?)?name)[ \\t]{0,3}:?[ \\t]{0,3}\\n?[ \\t]{0,3})(?-i:(?!(?:First|Surname|Forenames?|Name|Date|Address|Title|National|Employee|Employer|Tax|Postcode|Works|Payroll|Signature|Account|Accounts|Bank|Branch|Sort|UTR|NI|NINO|Your|Leaving|Total|Pay|Final|Certificate|Unique|Issue|Income|Telephone|Phone|Email|Reference|Ref|HM|HMRC|Revenue|Customs|Page|Box|Example)(?![A-Za-z]))(?:[A-Z](?:[a-z'’\\-]+|[A-Z'’\\-]+)(?![A-Za-z0-9])|[A-Z]\\.?(?![A-Za-z0-9]))(?:[ \\t]{1,2}(?!(?:First|Surname|Forenames?|Name|Date|Address|Title|National|Employee|Employer|Tax|Postcode|Works|Payroll|Signature|Account|Accounts|Bank|Branch|Sort|UTR|NI|NINO|Your|Leaving|Total|Pay|Final|Certificate|Unique|Issue|Income|Telephone|Phone|Email|Reference|Ref|HM|HMRC|Revenue|Customs|Page|Box|Example)(?![A-Za-z]))(?:[A-Z](?:[a-z'’\\-]+|[A-Z'’\\-]+)(?![A-Za-z0-9])|[A-Z]\\.?(?![A-Za-z0-9]))){0,4}))",
      "description": "Name after Mr, Mrs, Ms, Miss, Mx or Dr in capitals or normal case (MR JOHN A SMITH), name after Name, Full name, Surname, Forenames, First name(s), Account holder, Employee's name, and words written one capital letter per box (S M I T H).",
      "enabled": true
    },
    {
      "name": "Address",
      "regex": "(?-i)(?:(?<![\\w/.,])\\d{1,4}[A-Za-z]?,?[ \\t]{1,2}(?:[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])[ \\t]{1,2}){1,3}(?i:(?:Road|Rd|Street|St|Avenue|Ave|Lane|Ln|Close|Crescent|Cres|Drive|Dr|Gardens|Gdns|Grove|Mews|Place|Pl|Rise|Row|Square|Sq|Terrace|Way|Walk|View|Hill|Court|Ct|Park|Green|Parade|Wharf|Yard|Gate|Mount|Vale|Croft|Meadows?|Fields|Chase|Glen|Heights|Cottages))(?![A-Za-z0-9])\\.?(?:,?[ \\t]{1,2}(?!Post[ \\t]?code|POSTCODE)[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])(?:[ \\t][A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])){0,2}){0,3})|(?:(?<![A-Za-z0-9])(?!Post[ \\t]?code|POSTCODE)[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])(?:,?[ \\t]{1,2}(?!Post[ \\t]?code|POSTCODE)[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])){0,3}(?=(?:[ \\t]{0,3}\\n[ \\t]{0,3}(?!Post[ \\t]?code|POSTCODE)[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])(?:,?[ \\t]{1,2}(?!Post[ \\t]?code|POSTCODE)[A-Z][A-Za-z'’\\-]+(?![A-Za-z0-9])){0,3}){0,2}[ \\t]{0,3}\\n?[ \\t]{0,3}(?:(?:Post[ \\t]?code|POSTCODE)?[ \\t:]{0,3}\\n?[ \\t]{0,3}(?!B[ \\t]?X[ \\t]?\\d|N[ \\t]?E[ \\t]?9[ \\t]?[89])[A-PR-UWYZ](?:[ \\t]?[A-HK-Y])?[ \\t]?\\d(?:[ \\t]?[A-HJKPSTUW\\d])?[ \\t]{0,3}\\d[ \\t]?[ABD-HJLNP-UW-Z][ \\t]?[ABD-HJLNP-UW-Z](?![A-Za-z0-9])|(?:Post[ \\t]?code|POSTCODE)(?![A-Za-z]))))",
      "description": "UK street line with house number and the town after it (14 Example Close, Little Town, Exampleshire), and the town and county lines just above or before a postcode, as in the address block of the return.",
      "enabled": true
    },
    {
      "name": "Postcode",
      "regex": "(?-i)(?<![A-Za-z0-9])(?!B[ \\t]?X[ \\t]?\\d|N[ \\t]?E[ \\t]?9[ \\t]?[89])[A-PR-UWYZ](?:[ \\t]?[A-HK-Y])?[ \\t]?\\d(?:[ \\t]?[A-HJKPSTUW\\d])?[ \\t]{0,3}\\d[ \\t]?[ABD-HJLNP-UW-Z][ \\t]?[ABD-HJLNP-UW-Z](?![A-Za-z0-9])|(?<=(?i:post[ \\t]?code)[ \\t:]{1,4})(?!B[ \\t]?X[ \\t]?\\d|N[ \\t]?E[ \\t]?9[ \\t]?[89])[A-PR-UWYZ](?:[ \\t]?[A-HK-Y])?[ \\t]?\\d(?:[ \\t]?[A-HJKPSTUW\\d])?(?![ \\t]?[A-Za-z0-9])",
      "description": "UK postcodes (AB1 2CD), also one character per box; after a Postcode label also the first half alone (NN4) when a scan reads the rest apart. HMRC and other organisation postcodes (BX9, NE98) stay visible.",
      "enabled": true
    },
    {
      "name": "Phone",
      "regex": "(?<![\\d+])(?:\\+44[ \\t]?(?:\\(0\\)[ \\t]?)?|\\(?0)[127](?:[ \\t\\-)]{0,2}\\d){9}(?![ \\t\\-]?\\d)",
      "description": "UK mobile and landline numbers (07700 900123, 01632 960123, +44 20 7946 0000). 0300, 0800 and other organisation numbers, like the HMRC helplines, stay visible.",
      "enabled": true
    },
    {
      "name": "Sort code",
      "regex": "(?<![\\d\\-])\\d{2}[ \\t]?[\\-–][ \\t]?\\d{2}[ \\t]?[\\-–][ \\t]?\\d{2}(?![\\d\\-])|(?<=sort[ \\t]?code[^\\n\\d]{0,24})\\d(?:[ \\t\\-]{0,3}\\d){5}(?![ \\t\\-]?\\d)|(?<!\\d)(?<!\\d[ \\t])\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d(?=[ \\t]{0,3}\\n?[ \\t]{0,3}\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d(?![ \\t]?\\d))",
      "description": "Bank sort code: 12-34-56, after Sort code, or one digit per box next to the account number.",
      "enabled": true
    },
    {
      "name": "Account number",
      "regex": "(?=\\d(?:[ \\t\\-]?\\d){5,9}(?![ \\t\\-]?\\d))(?<=account[ \\t]?(?:number|no\\.?|num)[^\\n\\d]{0,24})\\d(?:[ \\t\\-]?\\d){5,9}(?![ \\t\\-]?\\d)|(?=\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d(?![ \\t]?\\d))(?<=\\d[ \\t]?\\d[ \\t\\-–]{0,3}\\d[ \\t]?\\d[ \\t\\-–]{0,3}\\d[ \\t]?\\d[ \\t]{0,3}\\n?[ \\t]{0,3})\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d[ \\t]?\\d(?![ \\t]?\\d)",
      "description": "Bank account number after Account number, or the 8 digits next to a sort code.",
      "enabled": true
    },
    {
      "name": "IBAN",
      "regex": "(?-i)(?<![A-Za-z0-9])[A-Z]{2}\\d{2}(?:[ \\t]?[A-Z0-9]{4}){3,7}(?:[ \\t]?[A-Z0-9]{1,3})?(?![A-Za-z0-9])",
      "description": "IBAN for a refund to an account outside the UK, with or without spaces.",
      "enabled": true
    },
    {
      "name": "PAYE reference",
      "regex": "(?-i)(?<![A-Za-z0-9/])\\d[ \\t]?\\d[ \\t]?\\d[ \\t]{0,2}/[ \\t]{0,2}(?=[A-Z](?:[ \\t]?[A-Z]){0,8}(?:[ \\t]?\\d|[ \\t]{0,3}(?![^\\n])))[A-Z](?:[ \\t]?[A-Z0-9]){1,9}(?![A-Za-z0-9])|(?<![A-Za-z0-9/])(?<![A-Za-z0-9/][ \\t])\\d[ \\t]\\d[ \\t]\\d[ \\t]{0,2}/(?![ \\t]{0,2}[\\d/])|(?<![A-Za-z0-9/])\\d{3}/(?=[ \\t]{0,3}(?![^\\n]))|(?<![A-Za-z0-9])(?<![A-Za-z0-9][ \\t])(?!(?:[SC][ \\t])?K[ \\t]\\d|X[ \\t]\\d|S[ \\t]A[ \\t]\\d|C[ \\t]T[ \\t]\\d)[A-Z](?:[ \\t][A-Z]){0,2}(?:[ \\t]\\d){3,7}(?![ \\t]?[A-Za-z0-9])|(?<![A-Za-z0-9])\\d{3}[ \\t]?P[A-Z][ \\t]?\\d{7}[\\dX](?![A-Za-z0-9])",
      "description": "Employer PAYE reference (123/AB45678) and Accounts Office reference (123PA00012345), also in boxes, also when the boxes after the slash are read apart (H B 2 9 3 8 4). Words next to it, such as HM Revenue and Customs, stay visible; so do tax codes (K475).",
      "enabled": true
    },
    {
      "name": "Payroll ID",
      "regex": "(?=[A-Z0-9][A-Z0-9\\-/]{0,6}\\d)(?<=(?:id|er|no|\\.|#|:)[ \\t:.#\\n]{0,6})(?<=(?:payroll[ \\t]?(?:ID|number|no\\.?)|works[ \\t]?(?:number|no\\.?)(?:[ \\t]?/[ \\t]?payroll[ \\t]?(?:ID|number|no\\.?))?|employee[ \\t]?(?:number|no\\.?|ID)|staff[ \\t]?(?:number|no\\.?|ID))[ \\t:.#]{0,4}\\n?[ \\t]{0,3})(?=[A-Z\\-/]{0,6}\\d)[A-Z0-9][A-Z0-9\\-/]{2,15}(?![A-Za-z0-9])",
      "description": "Works or payroll number after its label.",
      "enabled": true
    },
    {
      "name": "Employer",
      "regex": "(?<=employer(?:'s|’s)?(?:[ \\t]?full)?[ \\t]?name(?:[ \\t]?and[ \\t]?address)?(?:[ \\t]?\\(including[ \\t]?postcode\\))?[ \\t]{0,3}:?[ \\t]{0,3}\\n?[ \\t]{0,3})(?-i:[A-Z][A-Za-z0-9&'’.,\\-]*(?:[ \\t]{1,2}[A-Za-z0-9&'’.,\\-]+){0,6})",
      "description": "Employer name after its label on P60 and P45. Off by default: turn it on when the employer is small enough to point to you.",
      "enabled": false
    }
  ],
  "builtin": {
    "email": true,
    "name": true,
    "address": true,
    "ip": false,
    "url": false,
    "amount": false,
    "accountNumber": true,
    "licensePlate": false,
    "barcode": true,
    "phone": false
  }
}
