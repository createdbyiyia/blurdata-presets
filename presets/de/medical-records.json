    {
      "name": "Geburtsdatum",
      "regex": "(?=\\d{1,2}[./ \\t]|(?:19|20)\\d{2})(?<![\\d.,/])(?:(?<=(?i:\\bgeb\\.?(?:[ \\t]am)?|\\bgeboren(?:[ \\t]am)?|\\bgeburtsdatum|\\bgeb\\.-?dat(?:um|\\.)?|\\bgeburtstag|\\bgeb\\.-?datum|\\bgeb\\.[ \\t]?dat\\.?)[ \\t]{0,2}:?[ \\t]{0,8})(?:(?:0?[1-9]|[12]\\d|3[01])\\.[ \\t]?(?:0?[1-9]|1[0-2])\\.[ \\t]?(?:19|20)?\\d{2}(?![\\d.])|(?:0?[1-9]|[12]\\d|3[01])\\.?[ \\t]?(?i:(?:Januar|Jänner|Februar|März|Maerz|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Jan|Feb|Mär|Mrz|Apr|Jun|Jul|Aug|Sep|Sept|Okt|Nov|Dez))\\.?[ \\t](?:19|20)\\d{2}|(?:19|20)\\d{2}(?![\\d.]))|(?<=\\*[ \\t]?)(?:(?:0?[1-9]|[12]\\d|3[01])\\.[ \\t]?(?:0?[1-9]|1[0-2])\\.[ \\t]?(?:19|20)\\d{2}(?!\\d)|(?:19|20)\\d{2}(?![\\d.]))|(?<=(?i:\\bjg\\.|\\bjahrgang)[ \\t]{1,2})(?:19|20)\\d{2}(?!\\d))",
      "description": "Date of birth in every form after its label: geb. am 03.07.1958, geb. 3.7.58, Geburtsdatum, Geb.-Dat., geboren am, 3. Juli 1958, *03.07.1958, (*1958), Jg. 1958. Stays on when Date is off.",
      "enabled": true
    },
    {
      "name": "Date",
      "regex": "(?=\\d{1,2}[./ \\t]|\\d{4}-)(?<![\\d.,/\\-])(?<!(?i:\\bgeb\\.?(?:[ \\t]am)?|\\bgeboren(?:[ \\t]am)?|\\bgeburtsdatum|\\bgeb\\.-?dat(?:um|\\.)?|\\bgeburtstag|\\bgeb\\.-?datum|\\bgeb\\.[ \\t]?dat\\.?)[ \\t]{0,2}:?[ \\t]{0,8})(?<!\\*[ \\t]?)(?:(?<![\\d.,/])(?:0?[1-9]|[12]\\d|3[01])\\.[ \\t]?(?:0?[1-9]|1[0-2])\\.[ \\t]?(?:19|20)\\d{2}(?![\\d])|(?<![\\d.,/])(?:0?[1-9]|[12]\\d|3[01])/(?:0?[1-9]|1[0-2])/(?:19|20)\\d{2}(?![\\d/])|(?<![\\d.,/])(?:0?[1-9]|[12]\\d|3[01])\\.?[ \\t]?(?i:(?:Januar|Jänner|Februar|März|Maerz|April|Mai|Juni|Juli|August|September|Oktober|November|Dezember|Jan|Feb|Mär|Mrz|Apr|Jun|Jul|Aug|Sep|Sept|Okt|Nov|Dez))\\.?[ \\t](?:19|20)\\d{2}|(?<![\\d\\-])(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])(?![\\d\\-])|(?<![\\d.,/])(?:0?[1-9]|[12]\\d|3[01])\\.(?:0?[1-9]|1[0-2])\\.(?=[ \\t]{0,2}(?:bis|-|–)[ \\t]{0,2}(?:0?[1-9]|[12]\\d|3[01])\\.(?:0?[1-9]|1[0-2])\\.(?:19|20)?\\d{2}(?!\\d)))",
      "description": "Every other full date: 02.10.2026, 2.10.2026, 02/10/2026, 2026-10-02, 2. Oktober 2026, also the first day of a range (vom 02.10. bis 13.10.2026): admission, discharge, exam and letter dates. Turn it off to keep these dates visible: dates of birth stay hidden.",
      "enabled": true
    },
    {
      "name": "Short date",
      "regex": "(?=\\d{1,2}\\.\\d)(?<![\\d.,/])(?<!(?i:\\bgeb\\.?(?:[ \\t]am)?|\\bgeboren(?:[ \\t]am)?|\\bgeburtsdatum|\\bgeb\\.-?dat(?:um|\\.)?|\\bgeburtstag|\\bgeb\\.-?datum|\\bgeb\\.[ \\t]?dat\\.?)[ \\t]{0,2}:?[ \\t]{0,8})(?<!\\*[ \\t]?)(?<![\\d.,/])(?:0?[1-9]|[12]\\d|3[01])\\.(?:0?[1-9]|1[0-2])\\.\\d{2}(?![\\d.,])",
      "description": "Date with a 2-digit year and no birth label, as on the Muster forms and in older records (12.10.26, 03.07.58). Turn it off if it covers numbers that are not dates.",
      "enabled": true
    },
    {
      "name": "KV-Nummer",
      "regex": "(?-i)(?:\\b[A-Z]\\d{9}\\b|(?=[A-Z]?\\d{6})(?<=(?i:versicherten-?nr\\.?|versichertennummer|vers\\.-?nr\\.?|kv-?nr\\.?|krankenversichertennummer|mitglieds-?nr\\.?|mitgliedsnummer)[ \\t]{0,2}:?[ \\t]{0,8})[A-Z]?\\d{6,12}\\b)",
