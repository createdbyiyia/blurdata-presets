      "regex": "(?-i)(?=[A-Z0-9][A-Z0-9\\-/.]{3})(?<=\\b(?i:fall-?(?:nr\\.?|nummer|id)|aufnahme-?(?:nr\\.?|nummer)|patienten-?(?:id|nr\\.?|nummer)|pat\\.-?(?:id|nr\\.?)|pid|auftrags-?(?:nr\\.?|nummer)|auftrag|labor-?(?:nr\\.?|nummer)|proben-?(?:nr\\.?|nummer)|befund-?(?:nr\\.?|nummer)|untersuchungs-?(?:nr\\.?|nummer)|behandlungs-?(?:nr\\.?|nummer)|maßnahme-?(?:nr\\.?|nummer)|msnr|episoden?-?(?:nr\\.?|nummer)|kranken(?:blatt|akten)-?(?:nr\\.?|nummer)|akten-?(?:nr\\.?|nummer)|archiv-?(?:nr\\.?|nummer))[ \\t]{0,2}:?[ \\t]{0,8})(?=[A-Z0-9\\-/.]*\\d)[A-Z0-9](?:[A-Z0-9]|[-/.](?=[A-Z0-9])){3,24}(?![A-Za-z0-9])",
