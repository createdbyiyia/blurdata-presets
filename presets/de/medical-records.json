    {
      "name": "Arzt",
      "regex": "(?-i)(?<=[ \\t])(?=\\p{Lu}|[vzdlto]\\p{Ll}{0,4}[ \\t])(?<=\\b(?:Dr\\.|Dres\\.|med\\.|dent\\.|nat\\.|phil\\.|habil\\.|univ\\.|vet\\.|medic\\.|hum\\.|sc\\.|biol\\.|h\\.[ \\t]?c\\.|Univ\\.|Prof\\.|PD|Priv\\.-Doz\\.|Dipl\\.-Med\\.|Dipl\\.-Psych\\.|MUDr\\.|OA|OÄ|Oberarzt|Oberärztin|Chefarzt|Chefärztin|Stationsarzt|Stationsärztin|Assistenzarzt|Assistenzärztin|Hausarzt|Hausärztin|Kollege|Kollegin|Kollegen)(?:[ \\t]?:)?[ \\t]{1,2})(?:\\p{Lu}\\.(?:-\\p{Lu}\\.)?[ \\t]{1,2}){0,2}(?:(?:von[ \\t]und[ \\t]zu|von[ \\t]der|von[ \\t]dem|von[ \\t]den|van[ \\t]der|van[ \\t]den|van[ \\t]de|de[ \\t]la|op[ \\t]de|von|vom|zu|zum|zur|van|de|del|della|di|da|dos|du|le|la|ten|ter|(?:Freiherr|Freifrau|Freiin|Graf|Gräfin|Prinz|Prinzessin|Edler|Edle|Ritter)[ \\t]von(?:[ \\t]der|[ \\t]dem)?)[ \\t])?(?!(?:Dr|Prof|PD|Priv|Dipl|Med|MUDr|Univ|OA|OÄ|Herr|Herrn|Frau|Fräulein|Kollege|Kollegen|Kollegin|Doktor|Schwester|Pfleger|Geb|Geboren|Geburtsdatum|Name|Vorname|Nachname|Patient|Patientin|Patienten|Anschrift|Adresse|Wohnort|Telefon|Tel|Fax|Mobil|Datum|Station|Zimmer|Fall|Fallnummer|Aufnahme|Entlassung|Versicherte|Versicherten|Versicherter|Krankenkasse|Kostenträger|Geschlecht|Diagnose|Diagnosen|Befund|Befunde|Labor|Klinik|Klinikum|Praxis|Ambulanz|Entlassungsbrief|Arztbrief|Kurzarztbrief|Befundbericht|Laborbefund|Überweisung|Bericht|Ihre|Ihren|Ihr|Unsere|Unser|Sehr|Mit|Und|Bei|Nach|Vor|Seit|Am|Im|In|Der|Die|Das|Den|Dem|Des|Ein|Eine|Einen|Keine|Kein|Siehe|Herz|Hausarzt|Hausärztin|Facharzt|Fachärztin|Oberarzt|Oberärztin|Chefarzt|Chefärztin|Stationsarzt|Stationsärztin|Assistenzarzt|Assistenzärztin|Arzt|Ärztin|Betreff|Betr|Ehemann|Ehefrau|Tochter|Sohn|Mutter|Vater|Jg|Jahrgang|Zeichen)\\b)(?:\\p{Lu}\\p{Ll}++(?:\\p{Lu}\\p{Ll}++)?+(?:[-'’]\\p{Lu}?\\p{Ll}++){0,3}+|\\p{Lu}{2,}+(?:[-'’]\\p{Lu}{2,}+){0,3}+)(?![:\\p{L}])(?:[ \\t](?:(?:von[ \\t]und[ \\t]zu|von[ \\t]der|von[ \\t]dem|von[ \\t]den|van[ \\t]der|van[ \\t]den|van[ \\t]de|de[ \\t]la|op[ \\t]de|von|vom|zu|zum|zur|van|de|del|della|di|da|dos|du