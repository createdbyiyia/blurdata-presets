{
  "id": "de.rechnung",
  "version": 1,
  "name": "German Rechnung",
  "emoji": "🧾",
  "description": "German invoice (Rechnung). Detects USt-IdNr (VAT ID), Steuernummer, IBAN, BIC/SWIFT (context-anchored), German dates, German phone numbers, German street addresses and PLZ + city, plus names and emails. Amounts kept visible so line items stay readable — toggle 'Amounts' manually to hide totals too.",
  "language": "de",
  "country": "DE",
  "tags": ["invoice", "rechnung", "germany", "billing", "umsatzsteuer", "compliance"],
  "patterns": [
    {
      "name": "USt-IdNr",
      "regex": "(?-i)\\bDE\\s?\\d{9}\\b",
      "description": "German VAT identification number — 'DE' + 9 digits",
      "enabled": true
    },
    {
      "name": "Steuernummer",
      "regex": "(?i)\\b(?:steuernummer|steuer-?nr\\.?|st\\.?-?nr\\.?)\\s*[:\\-]?\\s*(\\d{2,3}[\\/\\s]?\\d{3,4}[\\/\\s]?\\d{4,5})\\b",
      "description": "German tax number — context-anchored, format varies by Bundesland",
      "enabled": true
    },
    {
      "name": "IBAN",
      "regex": "(?-i)\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]){11,30}\\b",
      "description": "International Bank Account Number — supports spaces between groups",
      "enabled": true
    },
    {
      "name": "BIC / SWIFT",
      "regex": "(?i)\\b(?:BIC|SWIFT)\\s*[:\\-]?\\s*([A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)\\b",
      "description": "Bank identifier code — 8 or 11 chars, context-anchored to avoid false positives",
      "enabled": true
    },
    {
      "name": "German date (DD.MM.YYYY)",
      "regex": "\\b\\d{2}\\.\\d{2}\\.\\d{4}\\b",
      "description": "German date format — DD.MM.YYYY",
      "enabled": true
    },
    {
      "name": "German phone number",
      "regex": "(?<!\\d)(?:\\+49|0)[\\s/.\\-]?(?:\\(0\\))?[\\s/.\\-]?\\d{2,5}[\\s/.\\-]?\\d{4,10}(?!\\d)",
      "description": "German phone — fixed or mobile, optional +49, bounded",
      "enabled": true
    },
    {
      "name": "German street address",
      "regex": "(?i)\\b[A-ZÄÖÜ][\\p{L}.\\-]*(?:weg|stra(?:ß|ss)e|str\\.?|platz|gasse|allee|ring|hof|damm|ufer|steig|chaussee|tor|markt)\\s+\\d+\\s?[a-z]?\\b",
      "description": "German street name + number",
      "enabled": true
    },
    {
      "name": "German postal code + city",
      "regex": "(?-i)\\b\\d{5}\\s+[A-ZÄÖÜ][\\p{L}\\-]+(?:\\s+(?:am|an|im|in|bei|ob)\\s+(?:der|dem)?\\s*[A-ZÄÖÜ][\\p{L}\\-]+)?(?:\\s+[A-ZÄÖÜ][\\p{L}\\-]+){0,2}\\b",
      "description": "German PLZ (5 digits) + city name",
      "enabled": true
    }
  ],
  "builtin": {
    "email": true,
    "name": true,
    "address": true,
    "ip": false,
    "url": false,
    "amount": false,
    "accountNumber": true,
    "licensePlate": false
  }
}
