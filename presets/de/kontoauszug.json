{
  "id": "de.kontoauszug",
  "version": 1,
  "name": "German Kontoauszug",
  "emoji": "🏦",
  "description": "German bank statement (Kontoauszug). Detects IBAN, BIC/SWIFT, Bankleitzahl (BLZ), Kontonummer, German dates, German phones and addresses, plus names and account holders. Amounts kept visible so you can prove income while redacting identities — toggle 'Amounts' manually to hide balances too.",
  "language": "de",
  "country": "DE",
  "tags": ["bank statement", "kontoauszug", "germany", "banking", "finance", "gdpr"],
  "patterns": [
    {
      "name": "IBAN",
      "regex": "(?-i)\\b[A-Z]{2}\\d{2}(?:\\s?[A-Z0-9]){11,30}\\b",
      "description": "International Bank Account Number — supports spaces between groups",
      "enabled": true
    },
    {
      "name": "BIC / SWIFT",
      "regex": "(?i)\\b(?:BIC|SWIFT)\\s*[:\\-]?\\s*([A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)\\b",
      "description": "Bank identifier code — 8 or 11 chars, context-anchored",
      "enabled": true
    },
    {
      "name": "Bankleitzahl (BLZ)",
      "regex": "(?i)\\b(?:blz|bankleitzahl)\\s*[:\\-]?\\s*(\\d{8})\\b",
      "description": "German bank sort code — 8 digits, context-anchored",
      "enabled": true
    },
    {
      "name": "Kontonummer",
      "regex": "(?i)\\b(?:kontonummer|konto-?nr\\.?|kto\\.?-?nr\\.?)\\s*[:\\-]?\\s*(\\d{6,10})\\b",
      "description": "German account number — 6-10 digits, context-anchored",
      "enabled": true
    },
    {
      "name": "German date (DD.MM.YYYY)",
      "regex": "\\b\\d{2}\\.\\d{2}\\.\\d{4}\\b",
      "description": "German date format — DD.MM.YYYY",
      "enabled": true
    },
    {
      "name": "German street address",
      "regex": "(?i)\\b[A-ZÄÖÜ][\\p{L}.\\-]*(?:weg|stra(?:ß|ss)e|str\\.?|platz|gasse|allee|ring|hof|damm|ufer|steig|chaussee|tor|markt)\\s+\\d+\\s?[a-z]?\\b",
      "description": "German street name + number",
      "enabled": true
    },
    {
      "name": "German postal code + city",
      "regex": "(?-i)\\b\\d{5}\\s+[A-ZÄÖÜ][\\p{L}\\-]+(?:\\s+(?:am|an|im|in|bei|ob)\\s+(?:der|dem)?\\s*[A-ZÄÖÜ][\\p{L}\\-]+)?(?:\\s+[A-ZÄÖÜ][\\p{L}\\-]+){0,2}\\b",
      "description": "German PLZ (5 digits) + city name",
      "enabled": true
    }
  ],
  "builtin": {
    "email": true,
    "name": true,
    "address": true,
    "ip": false,
    "url": false,
    "amount": false,
    "accountNumber": true,
    "licensePlate": false
  }
}
