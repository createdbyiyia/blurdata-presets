{
  "id": "de.kontoauszug",
  "version": 3,
  "name": "German Kontoauszug",
  "emoji": "🏦",
  "description": "German bank statement (Kontoauszug). Detects IBAN, BIC/SWIFT, Bankleitzahl (BLZ), Kontonummer, German dates, German phones and addresses, plus names and account holders. Amounts kept visible so you can prove income while redacting identities — toggle 'Amounts' manually to hide balances too.",
  "language": "de",
  "country": "DE",
  "tags": ["bank statement", "kontoauszug", "germany", "banking", "finance", "gdpr"],
  "patterns": [
    {
      "name": "IBAN",
      "regex": "(?-i)\\b[A-Z]{2}\\d{2}(?:(?:[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]|(?:\\r\\n?|\\n)(?=[A-Z]{0,3}\\d[A-Z0-9]{0,3}(?![^\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000\\r\\n])))?[A-Z0-9]){11,30}\\b",
      "description": "International Bank Account Number, with or without spaces between groups.",
      "enabled": true
    },
    {
      "name": "BIC / SWIFT",
      "regex": "(?i)\\b(?:BIC|SWIFT)\\s*[:\\-]?\\s*([A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)\\b",
      "description": "Bank identifier code, 8 or 11 characters, matched with its BIC or SWIFT label.",
      "enabled": true
    },
    {
      "name": "BLZ",
      "regex": "(?i)\\b(?:blz|bankleitzahl)\\s*[:\\-]?\\s*(\\d{8})\\b",
      "description": "Bankleitzahl (German bank sort code): 8 digits, matched with its label (BLZ, Bankleitzahl).",
      "enabled": true
    },
    {
      "name": "Kontonummer",
      "regex": "(?i)\\b(?:kontonummer|konto-?nr\\.?|kto\\.?-?nr\\.?)\\s*[:\\-]?\\s*(\\d{6,10})\\b",
      "description": "German account number: 6-10 digits, matched with its label (Kontonummer, Konto-Nr., Kto.-Nr.).",
      "enabled": true
    },
    {
      "name": "Date",
      "regex": "\\b\\d{2}\\.\\d{2}\\.\\d{4}\\b",
      "description": "German date, DD.MM.YYYY.",
      "enabled": true
    },
    {
      "name": "Address",
      "regex": "(?i)\\b[A-ZÄÖÜ][\\p{L}.\\-]*(?:weg|stra(?:ß|ss)e|str\\.?|platz|gasse|allee|ring|hof|damm|ufer|steig|chaussee|tor|markt)[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+\\d+[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]?[a-z]?\\b",
      "description": "German street name + number",
      "enabled": true
    },
    {
      "name": "PLZ Ort",
      "regex": "(?-i)\\b\\d{5}[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+[A-ZÄÖÜ][\\p{L}\\-]+(?:[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?:am|an|im|in|bei|ob)[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+(?:der|dem)?[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]*[A-ZÄÖÜ][\\p{L}\\-]+)?(?:[\\t \\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000]+[A-ZÄÖÜ][\\p{L}\\-]+){0,2}\\b",
      "description": "German PLZ (5 digits) + city name",
      "enabled": true
    }
  ],
  "builtin": {
    "email": true,
    "name": true,
    "address": true,
    "ip": false,
    "url": false,
    "amount": false,
    "accountNumber": true,
    "licensePlate": false
  }
}
