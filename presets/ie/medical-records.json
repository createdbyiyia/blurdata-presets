{
    "id": "ie.medical-records",
    "version": 1,
    "name": "Irish Medical Records",
    "emoji": "🇮🇪",
    "description": "Irish hospital, GP and radiology records (HSE and private hospitals). Detects the value after Patient Name, Patient Address, Patient ID, MRN, Medical Record Number and Chart number with the label left readable (MURPHY, SEAN or MURPHY^SEAN, 12 Main Street, Ballsbridge, Dublin 4, D04 X2Y3 and the town or county line under it: Ballincollig, Co. Cork, Galway H91 E2K3; MRN-00123, CH-2023-1234), the date of birth in every form after DOB or Date of Birth, Irish dates (dd/mm/yyyy and long form), Eircodes (D02 X285, A65 F4E2, D6W 1234), Irish phone numbers (+353 1 234 5678, (01) 234 5678, 087 123 4567), UK postcodes for Northern Ireland addresses, hospital numbers of 6 or more digits, plus names, addresses and emails from the built-in detectors. Preserves lab values, measurements, exam and accession details.",
    "language": "en",
    "country": "IE",
    "tags": [
        "medical",
        "healthcare",
        "hospital",
        "clinical",
        "patient",
        "radiology",
        "ireland",
        "hse",
        "eircode",
        "gdpr"
    ],
    "patterns": [
        {
            "name": "MRN",
            "regex": "(?<=[ \\r\\n])(?=[A-Za-z0-9\\-/.]*\\d)(?<=(?:\\b(?:mrn|m\\.r\\.n\\.?)(?:[ \\t]?(?:\\#|no\\.?|nr\\.?|num\\.?|number))?|\\b(?:medical[ \\t]record|med\\.?[ \\t]?rec\\.?|chart)[ \\t]?(?:(?:\\#|no\\.?|nr\\.?|num\\.?|number)|id))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?<![A-Za-z0-9])(?!\\d{1,4}[/.\\-]\\d{1,2}[/.\\-]\\d{1,4}(?![A-Za-z0-9])|\\d{3}[ ]\\d{3}[ ]\\d{4}(?!\\d))(?=[A-Za-z0-9\\-/.]*\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,39}(?![A-Za-z0-9])|(?<![\\d.,])\\d{6,}(?![\\d.,])",
            "description": "Hospital number, MRN or chart number: 6 or more digits in a row with no digit, period or comma next to them (hospital numbers, local patient IDs), and the value after MRN, MRN No., MRN #, Medical Record Number, Chart number, Chart No. or Chart # (MRN-00123, A1234567, CH-2023-1234) with the label left readable. Lab values like 12.4 or 1,234.56 and short numbers stay visible.",
            "enabled": true
        },
        {
            "name": "Date",
            "regex": "(?:\\b(?:0?[1-9]|[12]\\d|3[01])[/\\-](?:0?[1-9]|1[0-2])[/\\-](?:19|20)\\d{2}\\b)|(?:\\b\\d{1,2}(?:st|nd|rd|th)?\\s+(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+(?:19|20)\\d{2}\\b)|(?:\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{1,2},?\\s+(?:19|20)\\d{2}\\b)|(?:(?<=[ \\r\\n])(?=\\d)(?<=(?:\\b(?:dob|d\\.o\\.b\\.?|date[ \\t]of[ \\t]birth|birth[ \\t]?date))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?:(?:0?[1-9]|[12]\\d|3[01])[/.\\-](?:0?[1-9]|[12]\\d|3[01])[/.\\-](?:(?:19|20)\\d{2}|\\d{2})(?!\\d|[/.\\-]\\d)|(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?[ \\-./]?(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?[ \\-./]?(?:(?:19|20)\\d{2}|\\d{2})(?![A-Za-z0-9])|(?:19|20)\\d{2}[/.\\-](?:0?[1-9]|1[0-2])[/.\\-](?:0?[1-9]|[12]\\d|3[01])(?![\\d/.\\-])))",
            "description": "Full dates: day-first dd/mm/yyyy or dd-mm-yyyy, '5 January 1980' or '5th January 1980', and 'January 5, 1980', years 1900-2099. After DOB, D.O.B., Date of Birth or Birth Date every form of the date of birth is covered too: 23.04.1975, 23-Apr-1975, 23APR1975, 23/04/75 and 1975-04-23.",
            "enabled": true
        },
        {
            "name": "Short date",
            "regex": "(?<![\\d/\\-])(?:0?[1-9]|[12]\\d|3[01])/(?:0?[1-9]|1[0-2])/\\d{2}(?![\\d/])",
            "description": "Day-first date with a 2-digit year (e.g. 05/03/62). Off by default, turn it on for older records.",
            "enabled": false
        },
        {
            "name": "Eircode",
            "regex": "(?-i)(?<![A-Za-z0-9])(?:[AC-FHKNPRTV-Y]\\d{2}|D6W)(?:[ ][0-9AC-FHKNPRTV-Y]{4}|(?=[0-9]{0,3}[AC-FHKNPRTV-Y])[0-9AC-FHKNPRTV-Y]{4})(?![A-Za-z0-9])",
            "description": "Irish postcode (Eircode): a routing key (D02, A65, T12, D6W) and four letters or digits, e.g. D02 X285, A65 F4E2, H91E2K3 (case-sensitive).",
            "enabled": true
        },
        {
            "name": "Phone",
            "regex": "(?<![\\d+])(?:(?:\\+|00)353[ \\-]?(?:\\(0\\)[ \\-]?)?|\\(0|0)(?:1|[2-9]\\d)\\)?[ \\-]?\\d{3}[ \\-]?\\d{3,4}(?!\\d)",
            "description": "Irish phone number: +353 1 234 5678, +353 (0)87 123 4567, (01) 234 5678, 01 234 5678, 021 427 1234, 087 123 4567, 0871234567. Dates, measurements and decimals are not phone numbers.",
            "enabled": true
        },
        {
            "name": "UK postcode",
            "regex": "(?-i)\\b[A-Z]{1,2}\\d[A-Z\\d]?\\s?\\d[A-Z]{2}\\b",
            "description": "UK postcode, for Northern Ireland and British addresses, e.g. BT1 1AA, SW1A 1AA (case-sensitive).",
            "enabled": true
        },
        {
            "name": "Patient name",
