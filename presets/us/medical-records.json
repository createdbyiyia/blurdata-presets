{
  "id": "us.medical-records",
  "version": 4,
  "name": "US Medical Records",
  "emoji": "🏥",
  "description": "US medical records, clinical notes and radiology reports. Detects patient names, dates of birth in every common format (also day first after DOB or Date of Birth), Medical Record Numbers (6+ digit runs without decimals, and the value after MRN or Chart number: MRN-00123, CH-2023-1234), SSN, full US street addresses, ZIP codes, emails and US phone numbers. Preserves lab values by ignoring numbers with commas/periods and short runs (under 5 digits). The value after a Patient Name, Patient Address or Patient ID label (radiology, RIS and PACS headers: SMITH, JOHN A or SMITH^JOHN, 123 Main St, Springfield, IL 62704 and the city, state and ZIP on the next line, MRN-00123) is covered too, while the label stays readable.",
  "language": "en",
  "country": "US",
  "tags": [
    "medical",
    "healthcare",
    "hipaa",
    "clinical",
    "patient",
    "phi",
    "usa"
  ],
  "patterns": [
    {
      "name": "MRN",
      "regex": "(?<=[ \\r\\n])(?=[A-Za-z0-9\\-/.]*\\d)(?<=(?:\\b(?:mrn|m\\.r\\.n\\.?)(?:[ \\t]?(?:\\#|no\\.?|nr\\.?|num\\.?|number))?|\\b(?:medical[ \\t]record|med\\.?[ \\t]?rec\\.?|chart)[ \\t]?(?:(?:\\#|no\\.?|nr\\.?|num\\.?|number)|id))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?!\\d{5}(?:-\\d{4})?(?![A-Za-z0-9\\-/.]))(?<![A-Za-z0-9])(?!\\d{1,4}[/.\\-]\\d{1,2}[/.\\-]\\d{1,4}(?![A-Za-z0-9])|\\d{3}[ ]\\d{3}[ ]\\d{4}(?!\\d))(?=[A-Za-z0-9\\-/.]*\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,39}(?![A-Za-z0-9])|(?<![\\d.,])\\d{6,}(?![\\d.,])",
      "description": "Medical Record Number: 6 or more digits in a row with no digit, period or comma next to them, and the value after MRN, MRN No., MRN #, Medical Record Number, Chart number, Chart No. or Chart # (MRN-00123, A1234567, CH-2023-1234) with the label left readable. Lab values like 12.4 or 1,234.56 and short numbers stay visible. 9-digit SSNs written without dashes are covered here too.",
      "enabled": true
    },
    {
      "name": "SSN",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "description": "Social Security Number written XXX-XX-XXXX.",
      "enabled": true
    },
    {
      "name": "ZIP",
      "regex": "\\b\\d{5}(?:-\\d{4})?\\b",
      "description": "US ZIP code, 5 digits or ZIP+4.",
      "enabled": true
    },
    {
      "name": "Date",
      "regex": "(?:\\b(?:0?[1-9]|1[0-2])[/\\-](?:0?[1-9]|[12]\\d|3[01])[/\\-](?:19|20)\\d{2}\\b)|(?:\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{1,2},?\\s+(?:19|20)\\d{2}\\b)|(?:\\b\\d{1,2}\\s+(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+(?:19|20)\\d{2}\\b)|(?:\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b)|(?:(?<=[ \\r\\n])(?=\\d)(?<=(?:\\b(?:dob|d\\.o\\.b\\.?|date[ \\t]of[ \\t]birth|birth[ \\t]?date))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?:(?:0?[1-9]|[12]\\d|3[01])[/.\\-](?:0?[1-9]|[12]\\d|3[01])[/.\\-](?:(?:19|20)\\d{2}|\\d{2})(?!\\d|[/.\\-]\\d)|(?:0?[1-9]|[12]\\d|3[01])(?:st|nd|rd|th)?[ \\-./]?(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?[ \\-./]?(?:(?:19|20)\\d{2}|\\d{2})(?![A-Za-z0-9])|(?:19|20)\\d{2}[/.\\-](?:0?[1-9]|1[0-2])[/.\\-](?:0?[1-9]|[12]\\d|3[01])(?![\\d/.\\-])))",
      "description": "Full dates in every common format: MM/DD/YYYY or MM-DD-YYYY, 'January 5, 1980' or 'Jan 5 1980', '5 January 1980' and ISO YYYY-MM-DD, years 1900-2099. After DOB, D.O.B., Date of Birth or Birth Date every form of the date of birth is covered too, day first included: 23/04/1975, 23.04.1975, 23-Apr-1975, 04/23/75.",
      "enabled": true
    },
    {
      "name": "Phone",
      "regex": "(?<!\\d)(?:\\+1[\\s\\-.]?)?(?:\\(\\d{3}\\)|\\d{3})[\\s\\-.]?\\d{3}[\\s\\-.]?\\d{4}(?!\\d)",
      "description": "US phone number: (XXX) XXX-XXXX, XXX-XXX-XXXX or XXX.XXX.XXXX, optional +1, not inside longer numbers.",
      "enabled": true
    },
    {
