{
  "id": "us.medical-records",
  "version": 3,
  "name": "US Medical Records",
  "emoji": "🏥",
  "description": "US medical records and clinical notes. Detects patient names, dates of birth in every common format, Medical Record Numbers (MRN — 6+ digit runs without decimals), SSN, full US street addresses, ZIP codes, emails and US phone numbers. Preserves lab values by ignoring numbers with commas/periods and short runs (under 5 digits). The value after a Patient Address or Patient ID label (radiology, RIS and PACS headers: 123 Main St, Springfield, IL 62704, MRN-00123, and the city or town and postcode on the next line) is covered too, while the label stays readable; the Patient name rule, off by default, does the same for the name after Patient Name (SMITH, JOHN A or SMITH^JOHN).",
  "language": "en",
  "country": "US",
  "tags": [
    "medical",
    "healthcare",
    "hipaa",
    "clinical",
    "patient",
    "phi",
    "usa"
  ],
  "patterns": [
    {
      "name": "MRN",
      "regex": "(?<![\\d.,])\\d{6,}(?![\\d.,])",
      "description": "Medical Record Number: 6 or more digits in a row with no digit, period or comma next to them. Lab values like 12.4 or 1,234.56 and short numbers stay visible. 9-digit SSNs written without dashes are covered here too.",
      "enabled": true
    },
    {
      "name": "SSN",
      "regex": "\\b\\d{3}-\\d{2}-\\d{4}\\b",
      "description": "Social Security Number written XXX-XX-XXXX.",
      "enabled": true
    },
    {
      "name": "ZIP",
      "regex": "\\b\\d{5}(?:-\\d{4})?\\b",
      "description": "US ZIP code, 5 digits or ZIP+4.",
      "enabled": true
    },
    {
      "name": "Date",
      "regex": "(?:\\b(?:0?[1-9]|1[0-2])[/\\-](?:0?[1-9]|[12]\\d|3[01])[/\\-](?:19|20)\\d{2}\\b)|(?:\\b(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+\\d{1,2},?\\s+(?:19|20)\\d{2}\\b)|(?:\\b\\d{1,2}\\s+(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?\\s+(?:19|20)\\d{2}\\b)|(?:\\b(?:19|20)\\d{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])\\b)",
      "description": "Full dates in every common format: MM/DD/YYYY or MM-DD-YYYY, 'January 5, 1980' or 'Jan 5 1980', '5 January 1980' and ISO YYYY-MM-DD, years 1900-2099.",
      "enabled": true
    },
    {
      "name": "Phone",
      "regex": "(?<!\\d)(?:\\+1[\\s\\-.]?)?(?:\\(\\d{3}\\)|\\d{3})[\\s\\-.]?\\d{3}[\\s\\-.]?\\d{4}(?!\\d)",
      "description": "US phone number: (XXX) XXX-XXXX, XXX-XXX-XXXX or XXX.XXX.XXXX, optional +1, not inside longer numbers.",
      "enabled": true
    },
    {
      "name": "Patient name",
      "regex": "(?-i)(?<=[ ,^\\r\\n])(?=[A-ZÀ-ÖØ-Þ]|(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){1,2}[A-ZÀ-ÖØ-Þ])(?:(?<=(?i:\\b(?:patient|pt\\.?)(?:['’]?s)?[ \\t]?(?:(?:full|legal|first|last|given|family|middle)[ \\t])?name|\\bpatient(?:['’]?s)?[ \\t](?:surname|forenames?)|\\bname[ \\t]of[ \\t]patient)(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?)(?:(?i:mr|mrs|ms|miss|mx|master|dr|prof|sir|dame|rev)\\.?[ ]{1,2})?)|(?<=[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-.]{0,25}(?:,[ ]{0,2}|[ ]|\\^)(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2})(?<=(?i:\\b(?:patient|pt\\.?)(?:['’]?s)?[ \\t]?(?:(?:full|legal|first|last|given|family|middle)[ \\t])?name|\\bpatient(?:['’]?s)?[ \\t](?:surname|forenames?)|\\bname[ \\t]of[ \\t]patient)(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?)(?:(?i:mr|mrs|ms|miss|mx|master|dr|prof|sir|dame|rev)\\.?[ ]{1,2})?(?:(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]{0,30}[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]{0,24}[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?![A-Za-zÀ-ÖØ-öø-ÿ0-9])(?:(?:,[ ]{0,2}|[ ]|\\^)(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2}(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]{0,30}[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]{0,24}[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?![A-Za-zÀ-ÖØ-öø-ÿ0-9])){0,3}(?:,[ ]{0,2}|[ ]|\\^))))(?<![A-Za-zÀ-ÖØ-öø-ÿ0-9])(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2}(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]*[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?:\\^(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]*[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])){0,5}(?![A-Za-zÀ-ÖØ-öø-ÿ0-9])(?=(?>(?:(?:,[ ]{0,2}|[ ]|\\^)(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2}(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]*[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?![A-Za-zÀ-ÖØ-öø-ÿ0-9])){0,5})(?=[ \\t]*(?:\\r|\\n|\\z)|[ ]{3}|\\t|[ ]{0,2}[^ \\tA-Za-zÀ-ÖØ-öø-ÿ]))(?:,(?=[ ]{0,2}(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2}(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)[A-ZÀ-ÖØ-Þ]))?",
      "description": "The name after Patient Name, Patient's Name, Pt Name, Patient Surname / Forename or Name of Patient (with or without ':' or '-', in any case): SMITH, JOHN A, John A. Smith, SMITH^JOHN (DICOM), one box a word. The label and a title (Mr, Mrs, Dr) stay visible; the name ends at the end of the line or before the next field.",
      "enabled": true
    },
    {
      "name": "Patient address",
      "regex": "(?-i)(?:(?<=[ \\r\\n])(?=\\d|(?i:flat|apt|apartment|unit|suite|ste|room|p\\.?[ ]?o\\.?[ ]?box|box|rr|r\\.r\\.|rural[ ]route|c/o|care[ ]of)(?![A-Za-z])|[A-ZÀ-ÖØ-Þ](?:(?>[^ \\t\\r\\n:;]*)[ ](?![^ \\t\\r\\n:]*[ \\t]?:)(?!(?i:dob|d\\.o\\.b\\.?|tel|telephone|phone|ph|mobile|mob|cell|fax|email|e-mail|mrn|nhs|sex|gender|age|date|patient|pt|gp|referring|ordering|physician|exam|accession|acc|hospital|id|ref|home[ ]phone)(?![A-Za-z0-9]))){1,8}[^ \\t\\r\\n:;0-9]*\\d)(?<=(?i:\\b(?:patient|pt\\.?)(?:['’]?s)?[ \\t]?(?:(?:home|current|permanent|mailing|postal)[ \\t])?(?:address|addr\\.?))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?<![A-Za-z0-9])(?!(?i:dob|d\\.o\\.b\\.?|tel|telephone|phone|ph|mobile|mob|cell|fax|email|e-mail|mrn|nhs|sex|gender|age|date|patient|pt|gp|referring|ordering|physician|exam|accession|acc|hospital|id|ref|home[ ]phone)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)[^ \\t\\r\\n:;]*[^ \\t\\r\\n:;,.](?:[,.]?[ ](?!(?i:dob|d\\.o\\.b\\.?|tel|telephone|phone|ph|mobile|mob|cell|fax|email|e-mail|mrn|nhs|sex|gender|age|date|patient|pt|gp|referring|ordering|physician|exam|accession|acc|hospital|id|ref|home[ ]phone)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)[^ \\t\\r\\n:;]*[^ \\t\\r\\n:;,.]){0,14})|(?:(?<=[ \\r\\n])(?<![A-Za-z0-9])(?=(?:[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,3},?[ ](?:AL|AK|AZ|AR|CA|CO|CT|DE|DC|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|PR|VI|GU)[ ]\\d{5}(?:-\\d{4})?|(?:[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,3}(?:,[ ]?[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,2})?,?[ ])?[A-Z]{1,2}\\d[A-Z\\d]?[ ]?\\d[A-Z]{2})(?=[ \\t]*(?:\\r|\\n|\\z)|[ ]{2}|\\t))(?<=(?i:\\b(?:patient|pt\\.?)(?:['’]?s)?[ \\t]?(?:(?:home|current|permanent|mailing|postal)[ \\t])?(?:address|addr\\.?))(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ][^\\r\\n]{1,100}(?:\\r\\n|\\r|\\n)|[ \\t]{0,3}[:#][ \\t]{0,30}(?:\\r\\n|\\r|\\n)[ \\t]{0,40}[^\\r\\n]{1,100}(?:\\r\\n|\\r|\\n))[ \\t]{0,40})(?:[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,3},?[ ](?:AL|AK|AZ|AR|CA|CO|CT|DE|DC|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|PR|VI|GU)[ ]\\d{5}(?:-\\d{4})?|(?:[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,3}(?:,[ ]?[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*(?:[ ][A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ.'’\\-]*){0,2})?,?[ ])?[A-Z]{1,2}\\d[A-Z\\d]?[ ]?\\d[A-Z]{2})(?=[ \\t]*(?:\\r|\\n|\\z)|[ ]{2}|\\t))",
      "description": "The address after Patient Address or Pt Address, to the end of the line or the next field, and the next line when it is the city, state and ZIP or the town and postcode (123 Main St, Springfield, IL 62704; 12 High Street / Leeds LS1 4AB). The label stays visible.",
      "enabled": true
    },
    {
      "name": "Patient ID",
      "regex": "(?-i)(?<=[ \\r\\n])(?=[A-Za-z0-9\\-/.]*\\d)(?<=(?i:\\b(?:patient|pt\\.?)(?:['’]?s)?[ \\t]?(?:identifier|identification|id|i\\.d\\.)(?:[ \\t]?(?:\\#|no\\.?|nr\\.?|num\\.?|number))?)(?:[ \\t]{0,3}(?:[:.#=\\-–—][ \\t]{0,3}){0,3}[ \\t]{0,19}[ ]|[ \\t]{0,3}[:#][ \\t]{0,10}(?:\\r\\n|\\r|\\n)(?:[ \\t]{0,29}[ ])?))(?<![A-Za-z0-9])(?:\\d{3}[ ]\\d{3}[ ]\\d{4}|(?=[A-Za-z0-9\\-/.]*\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,39})(?![A-Za-z0-9])",
      "description": "The identifier after Patient ID, Pt ID, Patient ID #, Patient ID No. or Patient Identifier: 1234567, MRN-00123, A12345678, RX-2023-000123. The label stays visible.",
