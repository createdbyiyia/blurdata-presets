|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]{0,30}[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]{0,24}[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?![A-Za-zÀ-ÖØ-öø-ÿ0-9])){0,3}(?:,[ ]{0,2}|[ ]|\\^))))(?<![A-Za-zÀ-ÖØ-öø-ÿ0-9])(?:(?:de|del|della|der|den|di|da|du|dos|das|la|le|van|von|y|bin|ibn|al|ten|ter)[ ]){0,2}(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|not|other)(?![A-Za-z0-9]))(?![^ \\t\\r\\n:]*[ \\t]?:)(?:(?:Jr|Sr|St|Ste|Mc)\\.|[A-ZÀ-ÖØ-Þ]\\.|[A-ZÀ-ÖØ-Þ][A-Za-zÀ-ÖØ-öø-ÿ'’\\-]*[A-Za-zÀ-ÖØ-öø-ÿ]|[A-ZÀ-ÖØ-Þ])(?:\\^(?!(?i:dob|d\\.o\\.b\\.?|sex|age|gender|mrn|id|nhs|date|dos|exam|examination|accession|acc|study|referring|referred|ordering|requesting|attending|physician|doctor|consultant|radiologist|technologist|location|hospital|clinic|patient|pt|name|address|addr|phone|tel|telephone|mobile|email|account|acct|visit|encounter|birth|male|female|unknown|modality|procedure|report|ct|mri|mr|mrs|ms|miss|mx|dr|prof|xr|us|cr|dx|nm|pet|dept|department|room|bed|status|priority|signed|dictated|insurance|gp|series|no|number|nr|n/a|na|none|see|same|n