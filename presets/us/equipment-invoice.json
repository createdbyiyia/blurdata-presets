{
  "id": "us.equipment-invoice",
  "version": 2,
  "name": "US Equipment Invoice / Sales Order",
  "emoji": "🚜",
  "description": "Invoices, sales orders and quotes from US machinery and equipment dealers (forestry, construction, farm, trucks and trailers), including old dot-matrix invoices scanned to PDF. Hides the customer: company and contact names, street and city lines of the Sold To, Bill To and Ship To blocks, customer phone numbers and e-mails, the customer number, the PO number, the tax, exemption or resale certificate number, the remarks after a Remarks, Comments, Notes or Delivery notes label, the lender and the loan, LN or contract number on a trade payoff, lien or financing line, the printed name of the signer, and every serial number (SER#, Serial No., S/N, SN, ESN, PIN, VIN, also 17-character PINs inside a table). Keeps make, model, year, hours, warranty codes, stock numbers, prices, totals and payoff amounts, dates, terms, notes that start with the dealer's standard wording (Prices valid..., Freight...), the invoice number (an optional pattern hides it too) and the dealer's name, phone, toll-free and fax numbers, mailboxes such as sales@ and web site. Limits: the dealer's own street and city line are covered like the customer's (remove them with the X); handwritten signatures, notes without a label, the second line of a Remarks or Notes block (a lender or loan number on it is still hidden) and serials in a table column that are not 17-character PINs need a manual box; a person or street that is not recognised on a line under the Sold To label of a scan stays visible; makes such as John Deere can be taken for a person.",
  "language": "en",
  "country": "US",
  "tags": [
    "equipment invoice",
    "sales order",
    "quote",
    "dealer",
    "machinery",
    "heavy equipment",
    "forestry",
    "logging",
    "construction",
    "farm equipment",
    "appraisal",
    "serial number",
    "purchase order",
    "dot matrix",
    "usa"
  ],
  "patterns": [
    {
      "name": "Serial",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[LlOoMmRrNnUu#$.:=\\-][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:SERIAL(?![A-Za-z])(?:[ \\t]?(?:NUMBER|NUM|NBR|NO)(?![A-Za-z])\\.?)?(?:[ \\t]{0,2}[#$])?|SER(?:(?:[ \\t]{0,2}[#$])|\\.(?:[ \\t]?NO(?![A-Za-z])\\.?)?|[ \\t]NO(?![A-Za-z])\\.?|[ \\t]NUM(?:BER)?(?![A-Za-z])\\.?)|S[ \\t]?/[ \\t]?N(?![A-Za-z])(?:[ \\t]{0,2}[#$])?|S\\.[ \\t]?N\\.(?:[ \\t]{0,2}[#$])?|E?SN(?![A-Za-z])(?:[ \\t]{0,2}[#$])?|S[MU](?=[ \\t]{0,2}:)|[PV]IN(?=[ \\t]{0,2}[#$:])(?:[ \\t]{0,2}[#$])?)[ \\t]{0,2}[:=\\-]?[ \\t]{0,3})(?:[A-Za-z0-9]{1,3}[ \\t](?=[A-Za-z0-9]{4}))?(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Serial number after its label: SER#, SER #, SER. NO., Serial, Serial No., Serial Number, S/N, SN, ESN, PIN:, VIN:, with or without colon. The label stays readable; make, model, year, hours and warranty codes are not touched.",
      "enabled": true
    },
    {
      "name": "Serial",
      "regex": "(?=[A-Za-z0-9])(?<=[Nn][ \\t]{1,2})(?<=(?<![A-Za-z0-9])[PV]IN[ \\t]{1,2})(?=[A-Za-z0-9]{8,17}(?![A-Za-z0-9]))(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9]{8,17}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Product or vehicle identification number of 8 to 17 characters right after PIN or VIN.",
      "enabled": true
    },
    {
      "name": "Serial",
      "regex": "(?-i)(?<![A-Za-z0-9\\-])(?=[A-Z0-9]{17}(?![A-Za-z0-9]))(?=(?:[0-9]{0,16}[A-Z]){3})(?=(?:[A-Z]{0,16}[0-9]){5})[A-Z0-9]{17}(?![A-Za-z0-9\\-])",
      "description": "17-character PIN or VIN anywhere on the page, also inside a table column without a label (letters and digits mixed).",
      "enabled": true
    },
    {
      "name": "PO",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[OoRr#$.:][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:(?:(?:CUST(?:OMER)?|YOUR)[ \\t]?)?P[ \\t]?[./]?[ \\t]?O\\.?(?![A-Za-z])|(?:PURCHASE|(?:CUST(?:OMER)?|YOUR)[ \\t]?\\.?[ \\t]?)[ \\t]?ORDER(?![A-Za-z]))(?:(?:[ \\t]?(?:[#$]|NO(?![A-Za-z])\\.?|NUM(?:BER)?(?![A-Za-z])\\.?|NBR(?![A-Za-z])\\.?))[ \\t]{0,2}:?|[ \\t]{0,2}:)[ \\t]{0,3})(?!(?:DATE|SHIP|SOLD|BILL|TERMS?|TAX|INV|INVOICE|PAGE|VIA|REF|SALES(?:PERSON|MAN)?|SLSMN|CUST|CUSTOMER|ACCT|ACCOUNT|ORDER|QTY|PHONE|FAX|BOX|NONE|N/A)(?![A-Za-z0-9]))(?![A-Za-z0-9\\-/.#]{1,25}[ \\t]?:)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){1,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])|(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[Oo.][ \\t]{1,2})(?<=(?<![A-Za-z0-9])P\\.?O\\.?[ \\t]{1,2})(?!(?:DATE|SHIP|SOLD|BILL|TERMS?|TAX|INV|INVOICE|PAGE|VIA|REF|SALES(?:PERSON|MAN)?|SLSMN|CUST|CUSTOMER|ACCT|ACCOUNT|ORDER|QTY|PHONE|FAX|BOX|NONE|N/A)(?![A-Za-z0-9]))(?![A-Za-z0-9\\-/.#]{1,25}[ \\t]?:)(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){1,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Customer purchase order number after PO #, P.O. No., PO Number, Customer PO, Purchase Order. P.O. Box addresses are not taken.",
      "enabled": true
    },
    {
      "name": "Tax ID",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[XxTtNnEeDdOoRrMmGg.#$:][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:(?:SALES[ \\t]?)?TAX(?:[ \\t]?EXEMPT(?:ION)?)?|EXEMPT(?:ION)?|RESALE|SELLER'?S?[ \\t]PERMIT|FEIN|FED(?:ERAL)?[ \\t]?(?:TAX[ \\t]?)?ID|EIN)(?![A-Za-z])(?:[ \\t]?(?:ID|I\\.D\\.|NO|NUMBER|NUM|NBR|CERT(?:IFICATE)?|PERMIT|REG(?:ISTRATION)?)(?![A-Za-z])\\.?){0,2}[ \\t]{0,2}(?:#[ \\t]{0,2}:?|:)?[ \\t]{0,3})(?!\\d{1,3}(?:,\\d{3})*\\.\\d{2}(?!\\d)|\\d+\\.\\d{2}(?!\\d))(?![\\d.]{1,8}[ \\t]?%)(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Customer tax, exemption or resale certificate number after Tax #, Tax ID, Tax Exempt No., Exempt #, Exemption Cert, Resale #, FEIN, Fed ID, EIN. Sales tax amounts and rates stay visible.",
      "enabled": true
    },
    {
      "name": "Customer no",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[OoRrMmDd.#:][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:CUST(?:OMER)?|ACC(?:OUN)?T|A/C)(?:[ \\t]?(?:#|NO(?![A-Za-z])\\.?|NUM(?:BER)?(?![A-Za-z])\\.?|NBR(?![A-Za-z])\\.?|ID(?![A-Za-z])))(?:[ \\t]{0,2}[#:])?[ \\t]{0,3})(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])|(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=:[ \\t]{0,3})(?<=(?<![A-Za-z0-9])(?:CUST|ACCT)[ \\t]{0,2}:[ \\t]{0,3})(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Customer or account number at the dealer after Cust #, Customer No., Customer ID, Account #, Acct No.",
      "enabled": true
    },
    {
      "name": "Customer",
      "regex": "(?=[A-Za-z0-9&'’#])(?<=[ \\t:])(?<=(?:[Oo]|[Nn]\\.?|:)[ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:(?:(?:SOLD|BILL|SHIP|INVOICE)[ \\t]?-?[ \\t]?TO|ATTN\\.?|ATTENTION)[ \\t]{0,2}:?|(?:DELIVER(?:ED)?[ \\t]TO|OWNER|LESSEE|CUSTOMER(?:[ \\t]NAME)?|BUYER|PURCHASER|CONSIGNEE|CONTACT|SITE[ \\t]CONTACT|PRINT(?:ED)?[ \\t]NAME|NAME[ \\t]\\(PRINT(?:ED)?\\)|ACCEPTED[ \\t]BY(?:[ \\t]\\(CUSTOMER\\))?|RECEIVED[ \\t]BY|SIGNED[ \\t]BY)[ \\t]{0,2}:)[ \\t]{0,3})(?!(?:(?:SOLD|SHIP|BILL)[ \\t]?TO|PH(?:ONE)?|TEL|CELL|MOBILE|FAX|E-?MAIL|DATE|P\\.?O\\.?|TERMS|CUST(?:OMER)?[ \\t]?(?:#|NO)|TAX|ACCT|TITLE)(?![A-Za-z])|[^ \\t\\n:]{1,25}[ \\t]?:)(?!(?:SAME|WILL[ \\t]CALL|PICK[ \\t]?-?UP|CUSTOMER[ \\t]PICK|N/A|NONE)(?![A-Za-z]))[A-Za-z0-9&'’#][A-Za-z0-9&'’#.\\-/()]{0,30}(?:(?:,?[ \\t]{1,2}|[ \\t]{1,2}[\\-–][ \\t]{1,2})(?!(?:(?:SOLD|SHIP|BILL)[ \\t]?TO|PH(?:ONE)?|TEL|CELL|MOBILE|FAX|E-?MAIL|DATE|P\\.?O\\.?|TERMS|CUST(?:OMER)?[ \\t]?(?:#|NO)|TAX|ACCT|TITLE)(?![A-Za-z])|[^ \\t\\n:]{1,25}[ \\t]?:)[A-Za-z0-9&'’#][A-Za-z0-9&'’#.\\-/()]{0,30}){0,14}",
      "description": "Customer name and address written on the same line as its label: Sold To:, Bill To:, Ship To:, Deliver To:, Customer:, Buyer:, Attn, Contact:, Site contact:, Print name:, Printed name:, Accepted by:, Received by:. Stops at the next label on the line; SAME, WILL CALL and PICK UP stay visible.",
      "enabled": true
    },
    {
      "name": "Customer",
      "regex": "(?m)(?<=(?<![^\\n])[ \\t]{0,6})(?=[A-Za-z0-9&'’])(?![^\\n]{0,100}(?<![A-Za-z])(?:EQUIPMENT|EQUIP|TRACTORS?|IMPLEMENTS?|MACHINERY|MOTORS|SALES|SUPPLY|SUPPLIES|RENTALS?|DEALERS?(?:HIP)?|TURF|POWER|PARTS|FINANCE|FINANCIAL|BANK|CREDIT|CAPITAL|LEASING|INSURANCE|AUCTIONS?|AUCTIONEERS|INVOICE|QUOTATION|SPECIMEN|THANK)(?![A-Za-z]))(?:[A-Za-z0-9&'’][A-Za-z0-9&'’.\\-]{0,25}(?:[ \\t]{1,2}|,[ \\t]?)){0,5}(?:(?:LOGGING|TIMBER|TIMBERLANDS|FORESTRY|FOREST[ \\t]PRODUCTS|EXCAVATING|EXCAVATION|GRADING|CONSTRUCTION|CONTRACTING|CONTRACTORS|BUILDERS|TRUCKING|HAULING|FARMS?|RANCH(?:ES)?|DAIRY|ORCHARDS?|NURSERY|LANDSCAPING|LAND[ \\t]CLEARING|LAND[ \\t]MANAGEMENT|PAVING|DEMOLITION|SITEWORK|UTILITIES|PIPELINE|ENTERPRISES|HOLDINGS|INDUSTRIES|SERVICES|(?:&|AND)[ \\t]SONS|BROTHERS|BROS\\.?)(?![A-Za-z])(?:,?[ \\t]{1,2}(?:L\\.?L\\.?C\\.?|INC\\.?|INCORPORATED|CO\\.|CORP\\.?|CORPORATION|COMPANY|LTD\\.?|LIMITED|L\\.?L\\.?P\\.?|PLLC|L\\.P\\.|LP)(?![A-Za-z]))?|[A-Za-z0-9&'’][A-Za-z0-9&'’.\\-]{0,25},?[ \\t]{1,2}(?:L\\.?L\\.?C\\.?|INC\\.?|INCORPORATED|CO\\.|CORP\\.?|CORPORATION|COMPANY|LTD\\.?|LIMITED|L\\.?L\\.?P\\.?|PLLC|L\\.P\\.|LP)(?![A-Za-z]))(?:,?[ \\t]{1,2}(?:YARD|SITE|LANDING|UNIT|LOT|DIVISION|DIV\\.?|BRANCH|SHOP|PLANT|CAMP|JOB)[ \\t]?#?[A-Za-z0-9\\-]{1,8}|[ \\t]{1,2}[\\-–][ \\t]{1,2}[A-Za-z0-9&'’][A-Za-z0-9&'’.\\-]{0,25}(?:[ \\t][A-Za-z0-9&'’][A-Za-z0-9&'’.\\-]{0,25}){0,3})?(?=[ \\t]{0,6}$)",
      "description": "A customer company alone on its line, as in the Sold To / Ship To block of a scan: a name ending in LLC, Inc., Co., Corp., Ltd. or in a trade word (Logging, Timber, Excavating, Construction, Trucking, Farms, Ranch, Enterprises, & Sons...), with an optional Yard / Site / Landing after it. Lines with Equipment, Tractor, Implement, Machinery, Sales, Supply, Rental, Bank or Finance are not taken for the customer, so the dealer's name stays visible (the Loan pattern hides a lender on a payoff, lien or financing line).",
      "enabled": true
    },
    {
      "name": "Address",
      "regex": "(?<![A-Za-z0-9])(?=[NSEW]?\\d)[NSEW]?\\d{1,6}[A-Z]?[ \\t]{1,2}(?:[NSEW]\\.?[ \\t])?(?:COUNTY|CNTY|CTY|CO\\.?|STATE|ST\\.?|US|U\\.S\\.|TOWNSHIP|TWP\\.?|PARISH|FARM[ \\t]TO[ \\t]MARKET)[ \\t]{1,2}(?:ROAD|RD\\.?|HWY\\.?|HIGHWAY|TRUNK|LINE|ROUTE|RTE\\.?)[ \\t]{1,2}[A-Z0-9]{1,5}(?:-?[A-Z])?(?:[ \\t]{1,2}[NSEW](?:\\.|(?![A-Za-z0-9])))?(?![A-Za-z0-9])|(?<![A-Za-z0-9])(?:RR|R\\.R\\.|RURAL[ \\t]ROUTE)[ \\t]?\\d{1,3}(?:,?[ \\t]{1,2}BOX[ \\t]\\d{1,5})?(?![A-Za-z0-9])",
      "description": "Rural street lines in full: N1234 County Road K, 4810 County Road 1200 N, W2233 State Hwy 64, RR 2 Box 44.",
      "enabled": true
    },
    {
      "name": "Address",
      "regex": "(?-i)(?m)(?<![A-Za-z\\d])(?!(?:No|Nr|Num|Number|Total|Ref|Code|Item|Qty|Page|Box|Tel|Fax|Phone|Account|Invoice|Order|Amount|Balance|Date|Year|Terms)(?![A-Za-z]))[A-Z][A-Za-z'.\\-]{1,24}(?:[ ]{1,2}[A-Z][A-Za-z'.\\-]{1,24}){0,2},[ ]{0,2}(?:AL|AK|AZ|AR|CA|CO|CT|DE|DC|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|PR|VI|GU)[ ]{1,2}\\d{5}(?:-\\d{4})?(?!\\d)|(?<=(?<![^\\n])[ \\t]{0,6})(?!(?:No|Nr|Num|Number|Total|Ref|Code|Item|Qty|Page|Box|Tel|Fax|Phone|Account|Invoice|Order|Amount|Balance|Date|Year|Terms)(?![A-Za-z]))[A-Z][A-Za-z'.\\-]{1,24}(?:[ ]{1,2}[A-Z][A-Za-z'.\\-]{1,24}){0,2}[ ]{1,2}(?:AL|AK|AZ|AR|CA|CO|CT|DE|DC|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|PR|VI|GU)[ ]{1,2}\\d{5}(?:-\\d{4})?(?=[ \\t]{0,6}$)",
      "description": "City, state and ZIP line of an address block: SPRINGFIELD IL 62704, Anytown, WI 54000 (US state codes only).",
      "enabled": true
    },
    {
      "name": "Remarks",
      "regex": "(?=[^ \\t\\n])(?<=:[ \\t]{0,3})(?:(?<=(?<![A-Za-z])(?:REMARKS?|COMMENTS?|SPECIAL[ \\t]INSTRUCTIONS|DELIVERY[ \\t]INSTRUCTIONS|(?:CUSTOMER|INTERNAL|DELIVERY|SALES|ORDER|SHIPPING|SPECIAL|ADDITIONAL|DEALER|JOB|SERVICE)[ \\t]NOTES?)[ \\t]{0,2}:[ \\t]{0,3})|(?<=(?<![A-Za-z])(?:NOTES?|MEMO)[ \\t]{0,2}:[ \\t]{0,3})(?!(?:PRICES?|PRICING|QUOTES?|QUOTATION|FREIGHT|VALID|TERMS|WARRANTY|HOURS[ \\t](?:AS|ARE)|SUBJECT[ \\t]TO|RETURNS?|RESTOCKING|SALES[ \\t]TAX|TAXES|TITLE|ALL[ \\t](?:PRICES|UNITS|SALES|PARTS|EQUIPMENT|ITEMS|RETURNS)|THIS[ \\t](?:QUOTE|QUOTATION|INVOICE|ORDER))(?![A-Za-z])))[^ \\t\\n](?:[^\\n]{0,250}[^ \\t\\n])?",
      "description": "The rest of the line after Remarks:, Comments:, Notes:, Note:, Delivery notes:, Sales notes:, Order notes:, Memo:, Special instructions:, Delivery instructions:, Customer notes:, Internal notes:. A note that starts with the dealer's standard wording (Prices valid..., Freight..., Warranty..., Terms...) stays visible.",
      "enabled": true
    },
    {
      "name": "Loan",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t:])(?<=[FfOoRrSsNnHhYyUuAa][ \\t]{0,2}:?[ \\t]{1,3})(?<=(?<![A-Za-z])(?:PAY[ \\t]?-?OFF(?:[ \\t]TO)?|LIEN[ \\t]?-?HOLDER(?:[ \\t]IS)?|(?:1ST|FIRST|2ND|SECOND)[ \\t]LIEN(?:[ \\t]?-?HOLDER)?|LIEN[ \\t](?:TO|WITH|HELD[ \\t]BY)|FINANC(?:ED|ING)[ \\t](?:THROUGH|THRU|BY|WITH|VIA)|LEASED[ \\t](?:THROUGH|THRU|BY|WITH|VIA)|LENDER|LESSOR)[ \\t]{0,2}:?[ \\t]{1,3})(?!(?:TO|IS|BY|HOLDER|LIENHOLDER|WITH|THROUGH|THRU|VIA|OF|FOR|THE[ \\t]CUSTOMER|AMOUNT|AMT|BALANCE|BAL|GOOD|QUOTE|DATE|DUE|LN|LOAN|CONTRACT|AGREEMENT|ACCT|ACCOUNT|NONE|N/A|TBD|CUSTOMER|BUYER|DEALER|SELLER|US)(?![A-Za-z]))(?:[A-Za-z&'’][A-Za-z0-9&'’.\\-]{0,30}|\\d{1,3}(?:ST|ND|RD|TH)(?![A-Za-z0-9]))(?:[ \\t]{1,2}(?!(?:LN|LOAN|CONTRACT|AGREEMENT|LEASE|ACCT|ACCOUNT|NO|NUMBER|NBR|FOR|AMOUNT|AMT|BALANCE|BAL|DUE|ON|AT|BEFORE|AFTER|BY|TO|PER|IS|WAS|WILL|WITH|PAYOFF)(?![A-Za-z]))(?:[A-Za-z&'’][A-Za-z0-9&'’.\\-]{0,30}|\\d{1,3}(?:ST|ND|RD|TH)(?![A-Za-z0-9]))){0,5}|(?<![A-Za-z0-9&'’.\\-])(?:(?!(?:TO|THROUGH|THRU|BY|WITH|VIA|HOLDER|LIENHOLDER|LIEN|PAYOFF|TRADE|FINANCED|FINANCING|LEASED|LENDER|LESSOR|IS|FROM|FOR|AND|OF|THE|CUSTOMER|BUYER)(?![A-Za-z]))[A-Za-z&'’][A-Za-z0-9&'’.\\-]{0,30}[ \\t]{1,2}){0,4}(?:BANK|CREDIT[ \\t]UNION|FINANCE|FINANCIAL|CAPITAL|LEASING|ACCEPTANCE|CREDIT|SAVINGS|TRUST)(?:,?[ \\t]{1,2}(?:N\\.?A\\.?|F\\.?S\\.?B\\.?|INC\\.?|LLC|CORP\\.?|CO\\.)(?![A-Za-z]))?(?=,?[ \\t]{1,3}(?:LN|LOAN|CONTRACT|AGREEMENT|LEASE)(?![A-Za-z])[^\\n]{0,12}?\\d)|(?=[A-Za-z0-9\\-/.]{0,24}\\d)(?=[A-Za-z0-9])(?<=[ \\t#:.\\-])(?<=[NnTtEeOoRrMmDd#:.][ \\t]{0,3})(?<=(?<![A-Za-z])(?:LN|LOAN|CONTRACT|AGREEMENT|LEASE)(?:[ \\t]?(?:#|NO\\.?|NUMBER|NBR|NUM\\.?|ID))?[ \\t]{0,2}[:#]?[ \\t]{0,3})(?<=(?<![A-Za-z])(?:PAY[ \\t]?-?OFF|LIEN|LENDER|FINANC|LEAS|LESSOR|LOAN|BANK|CREDIT|CAPITAL|ACCEPTANCE)[^\\n]{0,80})(?!\\$|\\d{1,3}(?:,\\d{3}){1,5}(?![\\d,])|\\d{1,12}\\.\\d{2}(?!\\d))(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Trade payoff, lien and financing lines that point to the customer's loan: the lender after Payoff to, Lien holder, Financed through, Leased through or Lender, or a name ending in Bank, Finance or Credit Union right before a loan number, and the LN, loan, contract or lease number (Payoff to Example Bank LN 1234-01). The payoff amount stays visible.",
      "enabled": true
    },
