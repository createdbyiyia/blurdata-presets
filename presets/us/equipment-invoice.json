{
  "id": "us.equipment-invoice",
  "version": 3,
  "name": "US Equipment Invoice / Sales Order",
  "emoji": "🚜",
  "description": "Invoices, sales orders and quotes from US machinery and equipment dealers (forestry, construction, farm, trucks and trailers), including old dot-matrix invoices scanned to PDF. Hides the customer: company and contact names, street and city lines of the Sold To, Bill To and Ship To blocks, customer phone numbers and e-mails, the customer number or code, the PO number, the tax, exemption or resale certificate number, the remarks after a Remarks, Comments, Notes or Delivery notes label, delivery and contact lines typed in capitals without a label (DELIVER TO, CALL, CUST TO SEND, PICKED UP), the lender and the loan, LN or contract number on a trade payoff, lien or financing line, the printed name of the signer, and every serial number (SER#, Serial No., S/N, SN, ESN, PIN, VIN, also 17-character PINs inside a table). Keeps the dealer's letterhead (name, street, P.O. Box, city, phone, toll-free and fax numbers, mailboxes such as sales@, web site), make, model, year, hours, warranty codes, stock numbers, prices, totals and payoff amounts, dates, terms, notes that start with the dealer's standard wording (Prices valid..., Freight...) and the invoice number (an optional pattern hides it too). The Addresses detector is off: it covered the dealer's street too. Limits: on a scan a customer's city line in mixed case (Pontiac, IL 61764) alone on its line looks like the dealer's and stays visible (switch on City line to hide it, the dealer's city line too), and a customer street in a business park (Industrial Dr.) too; on dot-matrix scans the reader often splits the Sold To and Ship To lines into single words, and a lone word or house number there needs a manual box; handwritten signatures, other notes without a label, the second line of a Remarks or Notes block (a lender or loan number on it is still hidden) and serials in a table column that are not 17-character PINs need a manual box too; makes such as John Deere can be taken for a person.",
  "language": "en",
  "country": "US",
  "tags": [
    "equipment invoice",
    "sales order",
    "quote",
    "dealer",
    "machinery",
    "heavy equipment",
    "forestry",
    "logging",
    "construction",
    "farm equipment",
    "appraisal",
    "serial number",
    "purchase order",
    "dot matrix",
    "usa"
  ],
  "patterns": [
    {
      "name": "Serial",
      "regex": "(?:(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[LlOoMmRrNnUu#$.:=\\-][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:SERIAL(?![A-Za-z])(?:[ \\t]?(?:NUMBER|NUM|NBR|NO)(?![A-Za-z])\\.?)?(?:[ \\t]{0,2}[#$])?|SER(?:(?:[ \\t]{0,2}[#$])|\\.(?:[ \\t]?NO(?![A-Za-z])\\.?)?|[ \\t]NO(?![A-Za-z])\\.?|[ \\t]NUM(?:BER)?(?![A-Za-z])\\.?)|S[ \\t]?/[ \\t]?N(?![A-Za-z])(?:[ \\t]{0,2}[#$])?|S\\.[ \\t]?N\\.(?:[ \\t]{0,2}[#$])?|E?SN(?![A-Za-z])(?:[ \\t]{0,2}[#$])?|S[MU](?=[ \\t]{0,2}:)|[PV]IN(?=[ \\t]{0,2}[#$:])(?:[ \\t]{0,2}[#$])?)[ \\t]{0,2}[:=\\-]?[ \\t]{0,3})(?:[A-Za-z0-9]{1,3}[ \\t](?=[A-Za-z0-9]{4}))?(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){2,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9]))|(?:(?=[A-Za-z0-9])(?<=[Nn][ \\t]{1,2})(?<=(?<![A-Za-z0-9])[PV]IN[ \\t]{1,2})(?=[A-Za-z0-9]{8,17}(?![A-Za-z0-9]))(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9]{8,17}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9]))|(?-i:(?<![A-Za-z0-9\\-])(?=[A-Z0-9]{17}(?![A-Za-z0-9]))(?=(?:[0-9]{0,16}[A-Z]){3})(?=(?:[A-Z]{0,16}[0-9]){5})[A-Z0-9]{17}(?![A-Za-z0-9\\-]))",
      "description": "Serial number after its label: SER#, SER #, SER. NO., Serial, Serial No., Serial Number, S/N, SN, ESN, PIN, VIN, with or without colon, and any 17-character PIN or VIN on the page, also in a table column without a label. The label stays readable; make, model, year, hours and warranty codes are not touched.",
      "enabled": true
    },
    {
      "name": "PO",
      "regex": "(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[OoRr#$.:][ \\t]{0,5})(?<=(?<![A-Za-z0-9])(?:(?:(?:CUST(?:OMER)?|YOUR)[ \\t]?)?P[ \\t]?[./]?[ \\t]?O\\.?(?![A-Za-z])|(?:PURCHASE|(?:CUST(?:OMER)?|YOUR)[ \\t]?\\.?[ \\t]?)[ \\t]?ORDER(?![A-Za-z]))(?:(?:[ \\t]?(?:[#$]|NO(?![A-Za-z])\\.?|NUM(?:BER)?(?![A-Za-z])\\.?|NBR(?![A-Za-z])\\.?))[ \\t]{0,2}:?|[ \\t]{0,2}:)[ \\t]{0,3})(?!(?:DATE|SHIP|SOLD|BILL|TERMS?|TAX|INV|INVOICE|PAGE|VIA|REF|SALES(?:PERSON|MAN)?|SLSMN|CUST|CUSTOMER|ACCT|ACCOUNT|ORDER|QTY|PHONE|FAX|BOX|NONE|N/A)(?![A-Za-z0-9]))(?![A-Za-z0-9\\-/.#]{1,25}[ \\t]?:)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){1,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])|(?=[A-Za-z0-9])(?<=[ \\t#:$=.\\-])(?<=[Oo.][ \\t]{1,2})(?<=(?<![A-Za-z0-9])P\\.?O\\.?[ \\t]{1,2})(?!(?:DATE|SHIP|SOLD|BILL|TERMS?|TAX|INV|INVOICE|PAGE|VIA|REF|SALES(?:PERSON|MAN)?|SLSMN|CUST|CUSTOMER|ACCT|ACCOUNT|ORDER|QTY|PHONE|FAX|BOX|NONE|N/A)(?![A-Za-z0-9]))(?![A-Za-z0-9\\-/.#]{1,25}[ \\t]?:)(?=[A-Za-z0-9\\-/.]{0,24}\\d)[A-Za-z0-9](?:[A-Za-z0-9]|[\\-/.](?=[A-Za-z0-9])){1,24}(?![A-Za-z0-9]|[\\-/.][A-Za-z0-9])",
      "description": "Customer purchase order number after PO #, P.O. No., PO Number, Customer PO, Purchase Order. P.O. Box addresses are not taken.",
      "enabled": true
